{
  "name": "dakp-worker",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "namedInputs": {
    "goSource": [
      "{projectRoot}/go.mod",
      "{projectRoot}/go.sum",
      "{projectRoot}/.golangci.yml",
      "{projectRoot}/**/*.go",
      "{workspaceRoot}/.golangci.yml",
      "{workspaceRoot}/flake.nix",
      "{workspaceRoot}/flake.lock"
    ]
  },
  "targets": {
    "test": { "cache": true, "outputs": [] },
    "lint": { "cache": true, "outputs": [] },
    "tidy": { "cache": true, "outputs": [] },
    "build": { "cache": true, "outputs": ["{options.outputPath}"] }
  }
}
