{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "dakp",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run pytest -q",
        "cwd": "dagster/projects/dakp"
      },
      "cache": true,
      "inputs": [
        "pythonInputs",
        "{workspaceRoot}/dagster/projects/dakp/pipeline/**/*.py",
        "{workspaceRoot}/dagster/projects/dakp/pipeline/pyproject.toml"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff check src tests && uv run ruff format --check src tests",
        "cwd": "dagster/projects/dakp"
      },
      "cache": true,
      "inputs": ["pythonInputs"]
    }
  }
}
