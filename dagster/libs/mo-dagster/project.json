{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "mo-dagster",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run pytest -q",
        "cwd": "dagster/libs/mo-dagster"
      },
      "cache": true,
      "inputs": [
        "pythonInputs"
      ],
      "outputs": []
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff check . && uv run ruff format --check .",
        "cwd": "dagster/libs/mo-dagster"
      },
      "cache": true,
      "inputs": [
        "pythonInputs"
      ],
      "outputs": []
    }
  }
}
