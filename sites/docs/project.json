{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "sites/docs/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/package-lock.json"
      ],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "sites/docs",
        "command": "npm run build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build", "lint"],
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/package-lock.json"
      ],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "sites/docs",
        "command": "npm run check:links"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "sites/docs",
        "command": "npm run dev"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/package-lock.json"
      ],
      "outputs": [],
      "options": {
        "cwd": "sites/docs",
        "command": "npm run check && npm run format:check"
      }
    }
  }
}
