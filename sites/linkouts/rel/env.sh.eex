#!/bin/sh

# Distribution over Fly's private IPv6 network. A single machine connects to nothing but
# itself (libcluster's DNSPoll finds only its own address), so this is safe to ship enabled;
# CLUSTER_QUERY in fly.toml is what discovers peers if the machine count ever grows.
#
# Without FLY_PRIVATE_IP (local release runs, docker smoke tests) the release keeps its
# default short-name distribution and none of this applies.
case "${FLY_PRIVATE_IP:-}" in
  "") ;;
  *)
    export RELEASE_DISTRIBUTION=name
    export RELEASE_NODE="${FLY_APP_NAME:-edge_linkouts}@${FLY_PRIVATE_IP}"
    export ERL_AFLAGS="-proto_dist inet6_tcp ${ERL_AFLAGS:-}"
    ;;
esac
