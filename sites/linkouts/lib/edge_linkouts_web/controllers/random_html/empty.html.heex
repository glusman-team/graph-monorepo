<Layouts.app flash={@flash}>
  <section class="state-page">
    <p class="state-kicker">No relationships stored</p>
    <h1 class="state-title">Nothing to show yet</h1>
    <p class="state-body">
      This store holds no edge documents, so there is no relationship to open. Once a knowledge
      graph has been loaded with <code>linkouts_upload</code>, this address opens one of its edges
      at random.
    </p>
  </section>
</Layouts.app>
