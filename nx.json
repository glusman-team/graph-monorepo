{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/.golangci.yml",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/flake.nix",
      "{workspaceRoot}/flake.lock",
      "{workspaceRoot}/nix/**/*"
    ],
    "pythonInputs": [
      "{projectRoot}/**/*.py",
      "{projectRoot}/pyproject.toml",
      "{projectRoot}/uv.lock",
      "{workspaceRoot}/dagster/libs/**",
      "{workspaceRoot}/flake.nix",
      "{workspaceRoot}/flake.lock"
    ]
  },
  "targetDefaults": {
    "build": { "cache": true },
    "lint": { "cache": true },
    "test": { "cache": true }
  },
  "plugins": ["@naxodev/gonx"]
}
